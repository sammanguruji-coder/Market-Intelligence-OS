# Copy this file to .env and fill in your keys.
# Both are optional: without them the app runs in demo mode against the
# bundled fixture corpus. Do not wrap values in quotes.

# --- Retrieval (Tavily) -------------------------------------------------
# Free tier at https://app.tavily.com — 1,000 credits/month.
TAVILY_API_KEY=

# --- Language model (Groq) ---------------------------------------------
# Free tier at https://console.groq.com — no card required.
GROQ_API_KEY=

# Current production models: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.6-27b. Note that llama-3.3-70b-versatile and
# llama-3.1-8b-instant were retired in June 2026 — if you set one of
# those here the app upgrades it to the documented successor rather
# than failing.
GROQ_MODEL=openai/gpt-oss-120b

# --- Retrieval tuning ---------------------------------------------------
TAVILY_RESULTS=6
TAVILY_DEPTH=advanced          # advanced returns full page text; basic returns snippets
TAVILY_TIME_RANGE=             # blank, or: day / week / month / year
TAVILY_NEWS_TOPIC=1            # use the news index for competition, regulation and risk
SEARCH_DELAY=0.10

# --- Model tuning -------------------------------------------------------
EXECUTIVE_SOURCE_LIMIT=6
GROQ_INPUT_CHARS=5000
MAX_GROQ_CALLS=15              # 13 domains + synthesis; below 14 some domains
                               # fall back to the deterministic writer
